# Node >=22. Copy to .env; never commit .env or put MODEL_API_KEY in Flutter.
HOST=127.0.0.1
PORT=8787
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
# Your DeepSeek API key; leave empty until configured on the server.
MODEL_API_KEY=
# responses | chat; choose only capabilities verified for your provider/model.
PROVIDER_API=chat
# json_schema | json_object | text
OUTPUT_MODE=json_object
# Chat API capabilities (DeepSeek supports max_tokens and reasoning_effort=none).
CHAT_MAX_TOKENS=4000
CHAT_REASONING_EFFORT=none
# A separate, random proxy credential (at least 24 characters).
PROXY_ACCESS_TOKEN=
ALLOWED_ORIGINS=https://abaddon145.github.io
REQUEST_TIMEOUT_MS=60000
REQUESTS_PER_MINUTE=20
CONCURRENCY=2
MAX_QUEUE_SIZE=40
# Central retry policy. SDK and Flutter do not retry automatically.
MAX_RETRIES=0
